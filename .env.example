# Шаблон. Реальные значения — только в .env, он закрыт .gitignore.
# ВНИМАНИЕ: до 2026-09-02 в этом файле лежал рабочий ключ, и он попал
# в коммит 3943f2a, запушенный в origin/main. Ключ подлежит отзыву —
# удаление значения отсюда утечку не отменяет.

LLM_API_KEY=
LLM_BASE_URL=https://prod-litellm.nationalbank.kz/v1
# LLM_VERIFY_SSL: значение не задано решением. Отключение проверки
# сертификата противоречит подходу app/fetcher.py (truststore, проверка
# не отключается). См. OQ-007 / D-031.
LLM_VERIFY_SSL=
